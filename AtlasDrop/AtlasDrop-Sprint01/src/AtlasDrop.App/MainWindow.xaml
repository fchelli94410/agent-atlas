<Window x:Class="AtlasDrop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlas Drop" Width="520" Height="430" MinWidth="460" MinHeight="390"
        WindowStartupLocation="Manual" Topmost="True" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="5"/><Setter Property="MinHeight" Value="50"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#172033"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Atlas Drop" FontSize="25" FontWeight="Bold"/>
            <TextBlock x:Name="ItemNameText" Text="En attente d’un clic molette…" FontSize="16" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,15,0,12">
            <StackPanel>
                <TextBlock Text="Dossier proposé" Foreground="#657089"/>
                <TextBlock x:Name="ProposedPathText" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <TextBlock x:Name="ConfidenceText" Text="" Foreground="#657089" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Border x:Name="ManualPanel" Grid.Row="2" Background="White" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="9" Padding="10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Choisis le dossier OneDrive" FontWeight="SemiBold" Margin="4"/>
                <TreeView x:Name="FolderTree" Grid.Row="1" Margin="0,7,0,0" SelectedItemChanged="OnFolderSelected"/>
            </Grid>
        </Border>
        <UniformGrid x:Name="DecisionButtons" Grid.Row="3" Columns="4" Margin="-5,12,-5,0">
            <Button x:Name="YesButton" Content="OUI" Background="#17803D" Foreground="White" Click="OnYes"/>
            <Button x:Name="NoButton" Content="NON" Background="#D97706" Foreground="White" Click="OnNo"/>
            <Button x:Name="ChooseButton" Content="CHOISIR" Background="#2563EB" Foreground="White" Click="OnChoose"/>
            <Button x:Name="CancelButton" Content="ANNULER" Click="OnCancel"/>
        </UniformGrid>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="MoveHereButton" Content="DÉPLACER ICI" Background="#17803D" Foreground="White" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnMoveHere"/>
            <TextBlock x:Name="StatusText" Text="Atlas Drop fonctionne en arrière-plan." VerticalAlignment="Center" TextAlignment="Center" Foreground="#657089" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
