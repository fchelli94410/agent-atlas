<Window x:Class="AtlasDrop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlas Drop" Width="680" Height="690" MinWidth="590" MinHeight="560"
        WindowStartupLocation="Manual" Topmost="True" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="5"/><Setter Property="MinHeight" Value="46"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#172033"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Atlas Drop" FontSize="25" FontWeight="Bold"/>
            <TextBlock x:Name="ItemNameText" Text="En attente d’un clic molette…" FontSize="16" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border x:Name="SuggestionPanel" Grid.Row="1" Background="White" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,14,0,8">
            <StackPanel>
                <TextBlock Text="Dossier proposé" Foreground="#657089" FontWeight="SemiBold"/>
                <ListBox x:Name="SuggestionList" Visibility="Collapsed"
                         SelectionChanged="OnSuggestionSelected" DisplayMemberPath="DisplayText"/>
                <TextBlock x:Name="ProposedPathText" Text="—" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock x:Name="ConfidenceText" Text="" Foreground="#657089" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border x:Name="RenamePanel" Grid.Row="2" Background="White" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <CheckBox x:Name="AutoRenameCheckBox" Content="Appliquer ce renommage lors du déplacement" FontWeight="SemiBold"/>
                <TextBox x:Name="RenameTextBox" Margin="0,7,0,0" Padding="8" FontSize="14"/>
                <TextBlock x:Name="AutoRenameStatusText" Foreground="#657089" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border x:Name="ManualPanel" Grid.Row="3" Background="White" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="9" Padding="14" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="4,0,4,4">
                    <TextBlock Text="Choisis le dossier OneDrive" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="OneDrive est la racine. Les dossiers affichés vont du niveau 1 au niveau 4."
                               Foreground="#657089" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,7,0,0">
                    <Button x:Name="SearchButton" Content="RECHERCHER" DockPanel.Dock="Right" MinHeight="38" Padding="10,5"/>
                    <TextBox x:Name="SearchTextBox" Padding="9" FontSize="15" VerticalContentAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="SearchResultsList" Grid.Row="2" MaxHeight="140" MinHeight="44" Margin="0,7,0,0"
                         FontSize="14" SelectionChanged="OnManualSearchResultSelected" DisplayMemberPath="DisplayPath"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <Border Grid.Row="3" Margin="0,9,0,7" BorderBrush="#AEB8C8" BorderThickness="1" CornerRadius="6" Padding="4">
                    <TreeView x:Name="FolderTree" MinHeight="300" FontSize="15" Padding="4"
                              SelectedItemChanged="OnFolderSelected"
                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Border>
                <StackPanel Grid.Row="4">
                    <TextBlock x:Name="SelectedManualDestinationText" Text="Aucun dossier sélectionné"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,2,3"/>
                    <DockPanel>
                        <Button x:Name="CreateFolderButton" Content="CRÉER LE DOSSIER" DockPanel.Dock="Right" MinHeight="38" Padding="10,5"/>
                        <TextBox x:Name="NewFolderNameTextBox" Padding="9" FontSize="14" Margin="0,5,0,0"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid x:Name="DecisionButtons" Grid.Row="4" Columns="4" Margin="-5,8,-5,0">
            <Button x:Name="YesButton" Content="OUI" Background="#17803D" Foreground="White" Click="OnYes"/>
            <Button x:Name="NoButton" Content="NON" Background="#D97706" Foreground="White" Click="OnNo"/>
            <Button x:Name="ChooseButton" Content="CHOISIR" Background="#2563EB" Foreground="White" Click="OnChoose"/>
            <Button x:Name="CancelButton" Content="ANNULER" Click="OnCancel"/>
        </UniformGrid>

        <StackPanel Grid.Row="5">
            <Button x:Name="MoveHereButton" Content="DÉPLACER ICI" Background="#17803D" Foreground="White" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnMoveHere"/>
            <Border x:Name="PostMovePanel" Background="#ECFDF3" BorderBrush="#17803D" BorderThickness="1" CornerRadius="8" Padding="10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Classement réussi. Le classement est-il conforme ?" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Margin="-5,5,-5,0">
                        <Button x:Name="ConfirmClassificationButton" Content="OUI" Background="#17803D" Foreground="White" Click="OnClassificationConfirmed"/>
                        <Button x:Name="CorrectClassificationButton" Content="NON" Background="#D97706" Foreground="White" Click="OnClassificationRejected"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,8,0,0">
            <TextBlock x:Name="PathLengthStatusText" Foreground="#657089" TextAlignment="Center" TextWrapping="Wrap"/>
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="ResetLearningButton" Content="EFFACER APPRENTISSAGE" DockPanel.Dock="Right" MinHeight="30" Padding="7,3"/>
                <CheckBox x:Name="LearningEnabledCheckBox" Content="Apprentissage activé" IsChecked="True" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="LearningStatusText" Foreground="#657089" TextAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Atlas Drop fonctionne en arrière-plan."
                       TextAlignment="Center" Foreground="#657089" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
