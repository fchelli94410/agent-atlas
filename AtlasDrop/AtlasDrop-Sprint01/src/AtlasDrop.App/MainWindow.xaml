<Window x:Class="AtlasDrop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlas Drop" Width="612" Height="820" MinWidth="520" MinHeight="650"
        WindowStartupLocation="Manual" Topmost="True" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA" ShowInTaskbar="True" PreviewKeyDown="OnWindowPreviewKeyDown"
        LayoutUpdated="OnFinishingWindowLayoutUpdated">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style x:Key="PrimaryDecisionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#17803D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E7EB"/>
                    <Setter Property="Foreground" Value="#4B5563"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,12,18,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <Button x:Name="RefreshSuggestionButton" DockPanel.Dock="Right"
                    Content="↻  RELANCER" ToolTip="Relancer l’analyse et actualiser les dossiers"
                    MinHeight="30" Padding="9,4" Margin="8,0,0,0"
                    FontSize="11" VerticalAlignment="Top" Click="OnRefreshSuggestionClicked"/>
            <StackPanel>
                <TextBlock Text="Atlas Drop" FontSize="23" FontWeight="Bold"/>
                <TextBlock x:Name="ItemNameText" Text="En attente d’un clic molette…"
                           Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>

        <Border x:Name="SelectedDestinationPanel" Grid.Row="1"
                Background="#ECFDF3" BorderBrush="#4ADE80"
                BorderThickness="1.5" CornerRadius="8" Padding="9" Margin="0,8,0,4">
            <StackPanel>
                <TextBlock Text="DOSSIER CHOISI" Foreground="#15803D"
                           FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="ProposedPathText" Text="—" Margin="0,3,0,0"
                           FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                <StackPanel x:Name="SearchLoadingPanel" Orientation="Horizontal" Margin="0,4,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="Analyse en cours…">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="Clic détecté — analyse en cours…">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="Actualisation des dossiers et nouvelle analyse…">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar x:Name="SearchLoadingProgress" Width="58" Height="4"
                                 IsIndeterminate="True" VerticalAlignment="Center"/>
                    <TextBlock Text="Recherche du meilleur emplacement…"
                               Foreground="#657089" FontSize="11" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="390"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="SuggestionPanel" Grid.Row="0" Background="White" BorderBrush="#CBD5E1"
                    BorderThickness="1.25" CornerRadius="9" Padding="7" Margin="0,1,0,4"
                    MinHeight="390">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="1,0,1,0">
                        <Border x:Name="ConfidenceBadge" DockPanel.Dock="Right" Background="#E8F0FF"
                                Margin="4,0,0,0" CornerRadius="7" Padding="4,1">
                            <TextBlock x:Name="ConfidenceLevelText" Text="EN ATTENTE"
                                       Foreground="#1D4ED8" FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Dossier proposé" Foreground="#657089" FontWeight="SemiBold"
                                   FontSize="11.5" VerticalAlignment="Center"/>
                        <ListBox x:Name="SuggestionList" Visibility="Collapsed"
                                 SelectionChanged="OnSuggestionSelected" DisplayMemberPath="DisplayText"/>
                    </DockPanel>

                    <Border x:Name="ConfidenceInfoPanel" Grid.Row="1"
                            Background="#F8FAFC" BorderBrush="#D5DBE5" BorderThickness="0,0,0,1"
                            Padding="5,2,5,3" Margin="-1,2,-1,0">
                        <TextBlock x:Name="ConfidenceText" Text="" Foreground="#536078"
                                   FontSize="11.25" TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="2" Margin="0,3,0,0" BorderBrush="#D7DEE8" BorderThickness="1"
                            CornerRadius="6" Background="#FFFFFF" Padding="3">
                        <ScrollViewer x:Name="MainContentScrollViewer" Grid.Row="2" MinHeight="300"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <TreeView x:Name="FolderTree"
                                      Background="Transparent" BorderThickness="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseLeftButtonUp="OnFolderTreePreviewMouseLeftButtonUp"
                                      PreviewMouseWheel="OnFolderTreePreviewMouseWheel"
                                      LayoutUpdated="OnFolderTreeLayoutUpdated"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="RenamePanel" Grid.Row="1" Background="White" BorderBrush="#64748B"
                    BorderThickness="1.75" CornerRadius="9" Padding="9" Margin="0,0,0,4" MinHeight="88">
                <StackPanel>
                    <TextBlock Text="NOM PROPOSÉ" Foreground="#475569"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBox x:Name="RenameTextBox" Margin="0,4,0,0" Padding="7,5" FontSize="12.5"
                             MinHeight="32" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="AutoRenameCheckBox"
                              Content="Appliquer ce renommage lors du déplacement"
                              FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock x:Name="AutoRenameStatusText" Foreground="#7A8498" FontSize="9.5"
                               Margin="0,1,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="ExplorerRefinementPanel" Grid.Row="0" Grid.RowSpan="2"
                    Background="White" BorderBrush="#2563EB"
                    BorderThickness="1.5" CornerRadius="9" Padding="14" Visibility="Collapsed"
                    Margin="0,2,0,8">
                <StackPanel>
                    <TextBlock Text="1. Choisis le dossier dans l’Explorateur"
                               FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="La fenêtre OneDrive est ouverte en plein écran derrière Atlas Drop."
                               FontSize="13" Foreground="#657089" Margin="0,6,0,12" TextWrapping="Wrap"/>
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1"
                            CornerRadius="8" Padding="11">
                        <StackPanel>
                            <TextBlock Text="2. DOSSIER ACTUELLEMENT OUVERT"
                                       Foreground="#1D4ED8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TrackedExplorerDestinationText"
                                       Text="Ouverture de l’Explorateur…"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"
                                       TextWrapping="Wrap" LineHeight="20"/>
                            <TextBlock x:Name="DestinationReadyText" Text="● Destination en attente"
                                       Foreground="#D97706" Margin="0,8,0,0" FontWeight="SemiBold"/>
                            <ProgressBar x:Name="ExplorerLoadingProgress" Width="72" Height="4"
                                         HorizontalAlignment="Left" IsIndeterminate="True" Margin="0,7,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=DestinationReadyText}"
                                                         Value="● Ouverture de l’Explorateur…">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="PostMovePanel" Grid.Row="0" Grid.RowSpan="2"
                    Background="#ECFDF3" BorderBrush="#17803D"
                    BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Collapsed"
                    Margin="0,2,0,8">
                <StackPanel>
                    <TextBlock Text="Classement réussi. Le classement est-il conforme ?"
                               FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Margin="-4,8,-4,0">
                        <Button x:Name="ConfirmClassificationButton" Content="OUI, CONFIRMER"
                                Background="#17803D" Foreground="White"
                                PreviewMouseLeftButtonDown="OnConfirmClassificationPreview"
                                Click="OnClassificationConfirmed"/>
                        <Button x:Name="CorrectClassificationButton" Content="RETOUR ONEDRIVE"
                                Tag="NON, CORRIGER"
                                Background="#2563EB" Foreground="White"
                                Click="OnClassificationRejected"/>
                    </UniformGrid>
                    <Border Visibility="Collapsed" Height="0">
                        <Button x:Name="UndoMoveButton" Content="ANNULER LE DÉPLACEMENT (10 s)"
                                Background="#B91C1C" Foreground="White"
                                Click="OnClassificationRejected"/>
                    </Border>
                    <Button x:Name="ExplainChoiceButton"
                            Content="🎤 EXPLIQUER MON CHOIX"
                            Tag="EXPLICATION VOCALE — DISPONIBLE APRÈS CLASSEMENT"
                            Background="#6D28D9" Foreground="White" IsEnabled="False"
                            MinHeight="34" Padding="7,5" Margin="4,10,4,4"
                            Click="OnExplainChoiceClicked"/>
                    <Border x:Name="VoiceRulePanel" Visibility="Collapsed" Background="#F5F3FF"
                            BorderBrush="#A78BFA" BorderThickness="1" CornerRadius="7"
                            Padding="10" Margin="4,5,4,0">
                        <StackPanel>
                            <TextBlock x:Name="VoiceStatusText" Text="Écoute…"
                                       Foreground="#5B21B6" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Border x:Name="VoiceListeningVisual" Visibility="Collapsed"
                                    Background="#EDE9FE" CornerRadius="6" Padding="9" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="Écoute en cours…" Foreground="#5B21B6"
                                               FontWeight="Bold"/>
                                    <ProgressBar x:Name="VoiceLevelMeter" Minimum="0" Maximum="1" Value="0"
                                                 Height="7" Margin="0,7,0,0"/>
                                    <TextBlock Text="Parle normalement puis clique TERMINER pour arrêter."
                                               Foreground="#657089" FontSize="11" Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="VoiceTranscriptText" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="VoiceRulePreviewText" Margin="0,5,0,0"
                                       FontWeight="Bold" TextWrapping="Wrap"/>
                            <UniformGrid x:Name="VoiceRuleActionsPanel" Columns="2" Margin="-3,5,-3,0">
                                <UniformGrid.Style>
                                    <Style TargetType="UniformGrid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=VoiceRulePreviewText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UniformGrid.Style>
                                <Button Content="VALIDER" Background="#17803D"
                                        Foreground="White" Click="OnConfirmVoiceRuleClicked"/>
                                <Button Content="REFAIRE" Click="OnRedoVoiceRuleClicked"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,1,0,0" VerticalAlignment="Bottom">
            <Button x:Name="MoveHereButton" Content="DÉPOSER DANS CE DOSSIER"
                    Background="#17803D" Foreground="White" HorizontalAlignment="Stretch"
                    Visibility="Collapsed" IsEnabled="False" MinHeight="38"
                    Margin="3,0,3,5" Click="OnMoveHere"/>

            <Border x:Name="MovePreviewPanel" Background="#EFF6FF" BorderBrush="#93C5FD"
                    BorderThickness="1" CornerRadius="9" Padding="9" Margin="3,0,3,4" MinHeight="58">
                <StackPanel>
                    <TextBlock Text="ÉLÉMENT À DÉPLACER" Foreground="#1D4ED8"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Text, ElementName=ItemNameText}"
                               Margin="0,3,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                               FontSize="12.5" LineHeight="17"/>
                    <TextBlock x:Name="CurrentMovePreviewText" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <UniformGrid x:Name="DecisionButtons" Columns="2" Margin="-3,0,-3,1">
                <Button x:Name="YesButton" Content="C’EST EXACT" IsEnabled="False"
                        Style="{StaticResource PrimaryDecisionButtonStyle}"
                        FontSize="12" Padding="3,7" Margin="3" Click="OnYes"/>
                <Button x:Name="CancelButton" Content="ANNULER" FontSize="12"
                        Padding="3,7" Margin="3" Click="OnCancel"/>
            </UniformGrid>

            <TextBlock x:Name="PathLengthStatusText" Foreground="#657089"
                       TextAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="Longueur de chemin sûre.">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="LearningStatusText" Foreground="#657089" TextAlignment="Center"/>

            <Border Margin="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Child.Text, RelativeSource={RelativeSource Self}}"
                                         Value="Valide explicitement avant tout déplacement.">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Child.Text, RelativeSource={RelativeSource Self}}"
                                         Value="Retour à la proposition. Déplacement annulé.">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Child.Text, RelativeSource={RelativeSource Self}}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="StatusText" Text="Atlas Drop fonctionne en arrière-plan."
                           TextAlignment="Center" Foreground="#657089" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </Border>

            <Button x:Name="BackButton" Content="←  RETOUR"
                    Visibility="Collapsed" HorizontalAlignment="Left"
                    MinHeight="28" Padding="8,4" Margin="0,3,0,0"
                    FontSize="11" Click="OnBack"/>

            <StackPanel x:Name="LearningControlsPanel" Margin="0,1,0,0" VerticalAlignment="Bottom">
                <CheckBox x:Name="LearningEnabledCheckBox" Content="Apprentissage activé"
                          IsChecked="True" HorizontalAlignment="Left" FontSize="12" Margin="0,0,0,1"/>
                <WrapPanel HorizontalAlignment="Right" Margin="0">
                    <Button x:Name="HistoryButton" Content="HISTORIQUE" MinHeight="28"
                            Padding="7,2" Margin="2,1,0,0" FontSize="11" Click="OnHistoryClicked"/>
                    <Button x:Name="ManageLearningButton" Content="GÉRER APPRENTISSAGE"
                            MinHeight="28" Padding="7,2" Margin="2,1,0,0" FontSize="11" Click="OnManageLearningClicked"/>
                    <Button x:Name="ResetLearningButton" Content="TOUT EFFACER"
                            MinHeight="28" Padding="7,2" Margin="2,1,0,0" FontSize="11"/>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>